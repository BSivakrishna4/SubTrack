# ==============================================================================
# SubTrack Environment Configuration Template (.env.example)
# Copy this file to .env and configure strong, secret values for deployment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Security Configuration
# JWT_SECRET: Minimum 32-byte (256-bit) cryptographically strong signing key for HS256 JWT tokens.
# Both API Gateway and User Service require this secret; startup aborts if missing or < 32 bytes.
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_signing_key_here

# INTERNAL_SERVICE_SECRET: Shared token used for authenticated direct inter-service Feign calls
# (e.g., Subscription Service -> User Service profile lookup for email notifications,
#  and Subscription Service -> Payment Service transaction execution).
INTERNAL_SERVICE_SECRET=your_secure_internal_microservice_communication_secret_here

# INTERNAL_GATEWAY_TOKEN: Injected by API Gateway into downstream request headers
# after sanitizing client headers and verifying JWT claims. Downstream services
# verify this token to prevent attackers from directly supplying spoofed identity headers.
INTERNAL_GATEWAY_TOKEN=your_secure_internal_gateway_validation_token_here

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/subtrack_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Eureka Service Discovery
EUREKA_URI=http://localhost:8761/eureka/

# Email Notification Configuration (Gmail SMTP)
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
